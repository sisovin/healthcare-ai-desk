# Copy to .env and replace all development placeholders.
APP_NAME=Healthcare AI Desk
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=replace-this-with-a-long-random-secret-before-use
CORS_ORIGINS=http://localhost:5173

WEB_PORT=5173
API_PORT=8000
MYSQL_PORT=3306
REDIS_PORT=6379

MYSQL_DATABASE=healthcare_ai_desk
MYSQL_USER=had_app
MYSQL_PASSWORD=replace-with-a-strong-local-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-root-password
REDIS_PASSWORD=replace-with-a-strong-redis-password
